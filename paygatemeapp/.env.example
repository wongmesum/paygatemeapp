# Server
PORT=8080
DATABASE_URL=postgres://paygateme:paygateme@localhost:5432/paygatemeapp?sslmode=disable
REDIS_URL=redis://localhost:6379/0

# Admin auth
# Generate with: htpasswd -bnBC 10 "" "your-password" | tr -d ':\n'
ADMIN_PASSWORD=
ADMIN_JWT_SECRET=change-me-to-32-random-bytes

# Session encryption at rest (32 bytes hex = 64 hex chars)
# Generate with: openssl rand -hex 32
SESSION_ENCRYPT_KEY=

# Static QRIS payload for Shopee (EMVCo string from your Shopee merchant dashboard)
STATIC_QRIS=

# Telegram invoice notification (optional)
# Bot token from @BotFather, chat ID from getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
